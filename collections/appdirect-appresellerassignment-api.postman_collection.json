                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "Number of results per page. The default value is 50."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort field and order. For ascending sort order, use the '+[FieldName]' format. For descending order, use '-[FieldName]' format. The default value is '-createdOn'."
