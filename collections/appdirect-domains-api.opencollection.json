{
  "opencollection": "1.0.0",
  "info": {
    "name": "Companies AI Embed Domains API",
    "version": "v296.0-SNAPSHOT"
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List company domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/account/v2/companies/:companyUuid/domains",
            "params": [
              {
                "name": "companyUuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier of company in the API request"
              },
              {
                "name": "searchText",
                "value": "",
                "type": "query",
                "description": "Search term used to search domain names"
              }
            ]
          },
          "docs": "Retrieve a marketplace company's domains."
        },
        {
          "info": {
            "name": "Read company domain",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/account/v2/companies/:companyUuid/domains/:domainName",
            "params": [
              {
                "name": "companyUuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier of company in the API request"
              },
              {
                "name": "domainName",
                "value": "",
                "type": "path",
                "description": "Company domain name"
              }
            ]
          },
          "docs": "Get a specific company domain"
        },
        {
          "info": {
            "name": "List verified company domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/account/v2/companies/:companyUuid/verifiedDomains",
            "params": [
              {
                "name": "companyUuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier of company in the API request"
              }
            ]
          },
          "docs": "Retrieve a marketplace company's verified domains."
        }
      ]
    }
  ],
  "bundled": true
}