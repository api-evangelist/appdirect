            "params": [
              {
                "name": "answerId",
                "value": "",
                "type": "path",
                "description": "Answer id"
              },
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application id"
              },
              {
                "name": "questionId",
                "value": "",
                "type": "path",
                "description": "Question id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This call updates an existing answer on your marketplace."
