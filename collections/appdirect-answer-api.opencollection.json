              {
                "name": "answerId",
                "value": "",
                "type": "path",
                "description": "Answer id"
              },
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application id"
              },
              {
                "name": "questionId",
                "value": "",
                "type": "path",
                "description": "Question id"
              }
            ]
          },
          "docs": "This call returns all answer details for a specific product."
        },
        {
          "info": {
            "name": "Update an answer",
            "type": "http"
