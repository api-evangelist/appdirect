  },
  "items": [
    {
      "info": {
        "name": "Answer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all answers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/marketplace/v1/products/:applicationId/questions/:questionId/answers",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application id"
              },
              {
                "name": "questionId",
                "value": "",
                "type": "path",
                "description": "Question id"
              }
            ]
          },
          "docs": "List answers of a given question on an product"
        },
        {
          "info": {
            "name": "Create an answer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://marketplace.appdirect.com/api/marketplace/v1/products/:applicationId/questions/:questionId/answers",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "Application id"
              },
              {
                "name": "questionId",
                "value": "",
                "type": "path",
                "description": "Question id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This call creates an answer to a product question submitted on your marketplace."
        },
        {
          "info": {
            "name": "Retrieve an answer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/marketplace/v1/products/:applicationId/questions/:questionId/answers/:answerId",
