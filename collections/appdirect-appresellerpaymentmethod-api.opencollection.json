                "value": "",
                "type": "query",
                "description": "User ID"
              },
              {
                "name": "companyId",
                "value": "",
                "type": "query",
                "description": "Company ID"
              },
              {
                "name": "number",
                "value": "",
                "type": "query",
                "description": "Page number starting at 1. The default value is 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of results per page. The default value is 50."
