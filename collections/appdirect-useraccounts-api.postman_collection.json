          "id": "c770dc2e-333b-4d43-bcf9-54cb06f481d1",
          "name": "Create user connections",
          "request": {
            "name": "Create user connections",
            "description": {
              "content": "Creates a new user connection for Search. A connection (accountName) associates the app (application UUID) and user information (userId, companyId, and handle). The connection is used to, for example, identify events related to the user's app account. accountName Format: {user_handle}@{user_uuid}@{company_uuid}\nNote: Application UUID = Product UUID",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appwise",
                "v2",
                "accounts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app\": {\n    \"id\": \"<string>\"\n  },\n  \"user\": {\n    \"companyId\": \"<string>\",\n    \"handle\": \"<string>\",\n    \"userId\": \"<string>\"\n  }\n}",
              "options": {
