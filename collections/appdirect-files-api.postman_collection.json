          "name": "Upload a file to a chat session",
          "request": {
            "name": "Upload a file to a chat session",
            "description": {
              "content": "Uploads a file that can be referenced in messages sent to this chat. Max file size: 5MB. After uploading, use the returned file ID to reference it in the prompt field using ComplexMessageContent.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "chats",
                ":chatId",
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "chatId",
                  "description": "(Required) The unique identifier of the chat session."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The file to upload."
                },
                {
                  "key": "source",
                  "value": "<string>",
                  "type": "text",
                  "description": "The source of the file. Defaults to USER if not specified. (This can only be one of USER,SYSTEM)"
