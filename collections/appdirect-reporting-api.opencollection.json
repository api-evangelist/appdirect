{
  "opencollection": "1.0.0",
  "info": {
    "name": "Companies AI Embed Reporting API",
    "version": "v296.0-SNAPSHOT"
  },
  "items": [
    {
      "info": {
        "name": "Reporting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/reporting/v1/reports",
            "params": [
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "The number of reports to return from the results"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "The report generation start date and time, in epoch time"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "The lower bound index for the requested results"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "The report generation end date and time, in epoch time"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Report type"
              }
            ]
          },
          "docs": "Lists all reports that are automatically generated on your marketplace."
        },
        {
          "info": {
            "name": "Retrieve a report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://marketplace.appdirect.com/api/reporting/v1/report/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Report ID"
              }
            ]
          },
          "docs": "This call returns all details from a specific report."
        },
        {
          "info": {
            "name": "Delete report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://marketplace.appdirect.com/api/reporting/v1/report/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Report ID"
              }
            ]
          },
          "docs": "This call deletes a report from your marketplace"
        }
      ]
    }
  ],
  "bundled": true
}